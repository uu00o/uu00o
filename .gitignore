# ============ 只提交 frosted-electron（用户指定） ============
# 忽略工作区根目录下除 frosted-electron 和 .gitignore 外的所有内容
/*
!/frosted-electron/
!/.gitignore

# ============ frosted-electron 内部通用忽略 ============
# Node / 构建产物
node_modules/
dist/
build/
coverage/
*.log
.npm/
.yarn/
.pnpm-store/
.eslintcache

# 压缩包 / 大文件
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.dmg

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 敏感信息
.env
*.local
