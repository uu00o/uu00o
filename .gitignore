# ============ 只提交 frosted-electron 与 isaac-roguelike（用户指定） ============
# 忽略工作区根目录下除 frosted-electron / isaac-roguelike / .gitignore 外的所有内容
/*
!/frosted-electron/
!/isaac-roguelike/
!/.gitignore
!/README.md

# ============ frosted-electron 内部通用忽略 ============
# Node / 构建产物
node_modules/
dist/
build/
coverage/
*.log
.npm/
.yarn/
.pnpm-store/
.eslintcache

# 压缩包 / 大文件
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.dmg

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 敏感信息
.env
*.local

# frosted-electron 构建产物/运行时依赖（不入库）
frosted-electron/vendor/
frosted-electron/node_modules/
frosted-electron/dist/
frosted-electron/.electron-cache/
frosted-electron/.npm-cache/
